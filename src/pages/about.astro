---
import Features2 from '~/components/widgets/Features2.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About Wildnature',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="About us"
    title="Wildnature Rites of Passage"
    subtitle="A Community Interest Company based in the UK. We run nature-based camps and mentoring for boys aged 13–17, led by experienced guides who know how to work with young people."
  />

  <Steps2
    title="What we believe"
    subtitle="These convictions haven't changed since the first camp."
    items={[
      {
        title: 'Teens need to do hard things',
        description:
          "Not dangerous things — hard things. Things that require focus, patience, and grit. When a boy makes fire from scratch for the first time, or spends a night alone and makes it through, something happens that a certificate can't capture.",
      },
      {
        title: 'Good guides matter',
        description:
          "The men around the fire matter as much as the fire itself. Our mentors are not instructors delivering a curriculum. They're people who've done their own work, who listen, and who know the difference between stepping in and stepping back.",
      },
      {
        title: 'Nature is the right environment',
        description:
          "Woodland strips away the noise. It demands attention. It doesn't care about status or social media — and that's exactly the point. What happens in five days in the forest can mark a boy in ways that last for years.",
      },
    ]}
  />

  <Steps2
    title="How we work"
    isReversed={true}
    items={[
      {
        title: 'A deliberate structure',
        description:
          'Our camps follow a deliberate structure: arrival, community-building, skills, challenge, reflection, return. Each stage is intentional. Each has a purpose. Nothing is accidental.',
      },
      {
        title: 'Voluntary participation',
        description:
          'Participation in every activity is voluntary. No boy is forced to share, perform, or prove anything. What matters is that he shows up, pays attention, and gives it a go.',
      },
      {
        title: 'Properly held',
        description:
          "Every programme is fully risk-assessed, run in compliance with UK safeguarding law, and staffed by Enhanced DBS-checked mentors. Safety is not a box we tick. It's the ground everything else is built on.",
      },
    ]}
  />

  <Features2
    title="Our structure"
    subtitle="Wildnature Rites of Passage CIC is a Community Interest Company — a legal structure for organisations that exist for community benefit, not private profit."
    columns={3}
    items={[
      {
        title: 'Community Interest Company',
        description:
          'We carry an asset lock: any surplus is reinvested in the work. Our assets cannot be extracted for private use.',
        icon: 'tabler:building-community',
      },
      {
        title: 'Transparent governance',
        description:
          'Our governance is held by three Founding Directors, each accountable for the integrity and ethos of the organisation.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Regulated',
        description:
          'We are regulated by the CIC Regulator. Our policies are robust. Funders and donors can give with confidence.',
        icon: 'tabler:certificate',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get in touch',
        href: '/contact',
      },
      {
        variant: 'secondary',
        text: 'What we do',
        href: '/what-we-do',
      },
    ]}
  >
    <Fragment slot="title">
      <span class="font-heading">Want to know more?</span>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-deep-water dark:bg-bark"></div>
    </Fragment>
  </CallToAction>
</Layout>
