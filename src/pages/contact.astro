---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Get in Touch',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Contact"
    title="Get in Touch"
    subtitle="Whether you're a parent wondering if this is right for your son, a school exploring a partnership, or someone who wants to know more, the door is open."
  />

  <Features2
    title="We can help with"
    columns={3}
    items={[
      {
        title: 'Registration and places',
        description: 'Programme dates, places, and booking information for the current year.',
        icon: 'tabler:calendar',
      },
      {
        title: 'Concessionary places',
        description: "Cost should not be a barrier. Talk to us about what's possible.",
        icon: 'tabler:hand-stop',
      },
      {
        title: 'Volunteering and mentoring',
        description: "If you want to be part of the team, we'd like to hear from you.",
        icon: 'tabler:campfire',
      },
      {
        title: 'Schools and community partnerships',
        description: "We work with schools, youth organisations, and community groups. Let's talk.",
        icon: 'tabler:building-community',
      },
      {
        title: 'Press and funding enquiries',
        description: 'Journalists, trusts, and foundations are welcome to get in touch.',
        icon: 'tabler:news',
      },
      {
        title: 'Anything else',
        description: 'We read every message and aim to come back to you within 5 working days.',
        icon: 'tabler:mail',
      },
    ]}
  />

  <Features2
    title="Contact us"
    tagline="Reach us directly"
    columns={2}
    items={[
      {
        title: 'Email',
        description:
          '<a href="mailto:wildnature.rop@gmail.com" class="underline hover:text-ember transition-colors">wildnature.rop@gmail.com</a>',
        icon: 'tabler:mail',
      },
      {
        title: 'Response time',
        description:
          "We read every message and aim to come back to you within 5 working days. If your son is ready, or if you just want a conversation first, we're here.",
        icon: 'tabler:clock',
      },
    ]}
  />
</Layout>
