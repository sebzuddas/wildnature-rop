---
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/500.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
---

<style is:inline>
  :root {
    --aw-font-sans: 'DM Sans';
    --aw-font-serif: 'EB Garamond';
    --aw-font-heading: 'Cormorant Garamond';

    /* Brand palette */
    --wn-bark: #2c2c2a;
    --wn-oak-leaf: #3b6d11;
    --wn-ember: #633806;
    --wn-firelight: #fac775;
    --wn-deep-water: #085041;
    --wn-dawn-mist: #d3d1c7;
    --wn-parchment: #f1efe8;

    --aw-color-primary: #633806;
    --aw-color-secondary: #3b6d11;
    --aw-color-accent: #fac775;

    --aw-color-text-heading: #2c2c2a;
    --aw-color-text-default: #2c2c2a;
    --aw-color-text-muted: #6b6860;
    --aw-color-bg-page: #f1efe8;
    --aw-color-bg-page-dark: #2c2c2a;

    ::selection {
      background-color: #fac775;
      color: #2c2c2a;
    }
  }

  .dark {
    --aw-color-primary: #fac775;
    --aw-color-secondary: #3b6d11;
    --aw-color-accent: #633806;

    --aw-color-text-heading: #f1efe8;
    --aw-color-text-default: #d3d1c7;
    --aw-color-text-muted: rgb(211 209 199 / 66%);
    --aw-color-bg-page: #2c2c2a;

    ::selection {
      background-color: #633806;
      color: #f1efe8;
    }
  }

  /* Heading font applied globally */
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: 'Cormorant Garamond', ui-serif, Georgia, serif;
    letter-spacing: -0.01em;
  }

  /* Body prose uses serif */
  body {
    font-family: 'EB Garamond', ui-serif, Georgia, serif;
  }

  /* UI elements stay sans */
  nav,
  button,
  a.btn,
  .btn,
  label,
  input,
  select,
  textarea {
    font-family: 'DM Sans', ui-sans-serif, system-ui, sans-serif;
  }
</style>
